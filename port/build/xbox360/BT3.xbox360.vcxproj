<?xml version="1.0" encoding="utf-8"?>
<!--
  port/build/xbox360/BT3.xbox360.vcxproj
  Proyecto MSVC 2010 para Xbox 360 (PowerPC Xenon, big-endian, 32 bits).
  Plataforma "Xbox 360" (PlatformShortName "xbox"), toolset "2010-01".

  Historia:
    - 1.1 (fase 1): verificado que el toolchain produce un XEX vacio valido (docs/port/xbox360-build.md).
    - 1.2 (fase 1): este proyecto, smoke test "hello XEX" con main() en port/src/xbox360/xbr_main.c.

  Restricciones:
    - Regla 1 de AGENTS.md: el codigo especifico de 360 vive en port/src/xbox360/ y port/include/xbox360/.
    - Regla 8 de AGENTS.md: hasta que docs/port/xbox360-build.md defina los comandos, no se ejecuta
      ningun build de 360 desde fuera de este proyecto.
-->
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Xbox 360">
      <Configuration>Debug</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Xbox 360">
      <Configuration>Release</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- Property sheet del port: fija XDKInstallDir, XEDK y el orden de INCLUDE/LIB. -->
  <ImportGroup Label="PropertySheets">
    <Import Project="BT3.props" />
  </ImportGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{F0E1D2C3-B4A5-4697-8801-2C3D4E5F6A7B}</ProjectGuid>
    <RootNamespace>BT3</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <ProjectName>BT3</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.default.props" />
  <!-- Plataforma Xbox 360: el archivo Microsoft.Cpp.Xbox 360.props importa a su vez el props
       del toolset (2010-01 por defecto), el de cl/link/lib/imagexex y el de title (que define
       _XBOX y ConfigurationType=Application). No hay que importarlos a mano. -->

  <PropertyGroup>
    <ConfigurationType>Application</ConfigurationType>
    <!-- Subsistema "XBOX": la Link.Xbox 360.props ya fija Machine=PPCBE y AdditionalOptions /XEX:NO. -->
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- =====================================================================
       Configuracion comun a Debug y Release
       ===================================================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Warning level 3, multi-procesador desactivado (toolset por defecto).
           _XBOX lo anade el .Title.props de la plataforma Xbox 360. -->
      <WarningLevel>Level3</WarningLevel>
      <!-- Forzamos la inclusion de xbox_intellisense_platform.h como en el .Cl.Xbox 360.props;
           redundante en modo Release pero inocuo, y deja el proyecto portable si el toolset
           no se actualiza. -->
      <PreprocessorDefinitions>XBOX360;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat Condition="'$(Configuration)' == 'Debug'">ProgramDatabase</DebugInformationFormat>
      <Optimization Condition="'$(Configuration)' == 'Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <!-- xboxkrnl.lib (kernel) y xapilib.lib (CRT de Xbox 360) los aporta Core.props; aqui
           anadimos las APIs de juegos que vamos a usar a lo largo del port. La subtarea 1.3
           empezara a usar xinput2.lib (pad) y xaudio2.lib (sonido).
           SubSystem no se admite para Xbox 360 (link.xml: "Removed SubSystem"); el
           link.exe para PowerPC toma XBOX por defecto. -->
      <AdditionalDependencies>xinput2.lib;xaudio2.lib;d3d9.lib;d3dx9.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ImageXex>
      <!-- El nombre del .xex sigue al ProjectName. Output a $(OutDir)$(ProjectName).xex. -->
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </ImageXex>
  </ItemDefinitionGroup>

  <!-- =====================================================================
       Configuraciones Debug y Release
       IntDir se evalua tarde (despues de los imports), asi que el .obj va a
       obj\$(Configuration)\. OutputFile se evalua en Microsoft.Cpp.Xbox 360.props
       ANTES de estos PropertyGroups, asi que lo fijamos a mano para que el .exe
       y el .xex (vía ImageXexOutput) acaben en bin\$(Configuration)\ junto al
       .pdb y el .xdb, no sueltos en $(ProjectDir)$(Configuration)\.
       ===================================================================== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Xbox 360'">
    <OutDir>$(ProjectDir)bin\Debug\</OutDir>
    <IntDir>$(ProjectDir)obj\Debug\</IntDir>
    <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
    <ImageXexOutput>$(OutDir)$(ProjectName).xex</ImageXexOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <OutDir>$(ProjectDir)bin\Release\</OutDir>
    <IntDir>$(ProjectDir)obj\Release\</IntDir>
    <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
    <ImageXexOutput>$(OutDir)$(ProjectName).xex</ImageXexOutput>
  </PropertyGroup>

  <!-- =====================================================================
       Fuentes
       Por ahora el entry point (xbr_main.c), la capa de plataforma
       (xbr_platform.c) y los stubs PS2 -> XDK (xbr_stubs_sce.c). Las
       subtareas 1.4+ iran anadiendo los stubs de los subsistemas 1-7 y,
       al final, src/main.c y los .c del juego.
       ===================================================================== -->
  <ItemGroup>
    <ClCompile Include="..\..\src\xbox360\xbr_main.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\..\src\xbox360\xbr_platform.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\..\src\xbox360\xbr_stubs_sce.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
